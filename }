    function plgndr(l,m,x)
     real(rk)::plgndr,x       
     INTEGER(ik):: l,m
     INTEGER(ik):: i,ll
     real(rk)::pmm,somx2,fact,pmmp1,pll

     if(m.lt.0.or.m.gt.l.or.abs(x).gt.1.) then
        write(*,*) 'l=',l,'m=',m,'abs(x)=',Abs(x)
        stop  'bad arguments in plgndr'
     endif

     pmm=1._rk
     if(m.gt.0) then
        somx2=sqrt((1._rk-x)*(1._rk+x))
        fact=1._rk
        do 11 i=1,m
           pmm=-pmm*fact*somx2
           fact=fact+2._rk
11         continue
        endif
        if(l.eq.m) then
           plgndr=pmm
        else
           pmmp1=x*(2*m+1)*pmm
           if(l.eq.m+1) then
              plgndr=pmmp1

           else
              do 12 ll=m+2,l
                 pll=(x*(2*ll-1)*pmmp1-(ll+m-1)*pmm)/(ll-m)
                 pmm=pmmp1
                 pmmp1=pll
12               continue
                 plgndr=pll

              endif
           endif
           return

           end function plgndr


  



