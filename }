!Este es el programa de cuadratura y al final esta el programa que calcula la anisotropía
use types
use pothx
implicit none
real(rk)::rleg,pphi
real(rk)::  eps=1.d-12 !Tolerance in funcitons gaussa and gaussb
logical::qgau=.true.
real(rk)::pi=dacos(-1.0_rk)
integer(ik),parameter :: lorder=96
real(rk):: wht(lorder),xpt(lorder)
integer(ik)::lambda
integer(ik)::ind


 

Contains

 function vn(l,x1,x2,rfb)
   real(rk)::vn,x1,x2,rfb    
   integer(ik)::l
   rleg=rfb
   lambda=l
   vn=(2.0_rk*lambda+1.0_rk)*qgausa(x1,x2)/2.0_rk


   return
 end function vn


      function qgausa(a,b)
       real(rk)::qgausa
       real(rk),intent(in)::a,b       
       INTEGER(ik):: j
       real(rk):: ss,xr,xx  
       
      call glegen(lorder,xpt,wht,-1.0_rk,1.0_rk)
     !xpt=pi*(xpt+1d0)
      
     !write(*,*) 'x',xpt
     !write(*,*) 'w',wht
  

      ss=0.0_rk
      do 11 j=1,lorder
      xx=((b-a)*xpt(j)+(b+a))*0.5_rk
      ss=ss+wht(j)*fa(xx)
11    continue
      xr=0.5*(b-a)
      qgausa=xr*ss

      return
      END  function qgausa



     function fa(x)
      real(rk)::x,fa      
      !fa=dexp(x)*dcos(x)
      !fa=x**6-x**2*dsin(2.0_rk*x)
       fa=V(rleg,x,ind)*plgndr(lambda,0,x)

     return
     end function fa



